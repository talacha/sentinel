# Global options. HTTP/3 (QUIC) runs over UDP, which the firewall in docs/hackathon.md does not
# open (only TCP 80 and 443), so do not advertise it: browsers would try it, fail, and fall back.
{
	servers {
		protocols h1 h2
	}
}

# Caddy serves https://{$SENTINEL_DOMAIN}, obtains the certificate itself, and forwards to the app.
# The DNS A record for the domain must point at this machine, and ports 80 and 443 must be open.
{$SENTINEL_DOMAIN} {
	encode zstd gzip

	# Slightly above the app's own upload limit (MAX_UPLOAD_MB, default 20), so the app can give
	# a friendly error for oversized files.
	request_body {
		max_size 25MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy sentinel:8000
}

# www.<domain> redirects to the main site. This needs its own DNS record (a CNAME `www` pointing at
# the domain is enough): Caddy also gets a certificate for this name, and if it does not resolve to
# this machine that request fails and is retried in the background. The main site is unaffected.
www.{$SENTINEL_DOMAIN} {
	redir https://{$SENTINEL_DOMAIN}{uri} permanent
}
