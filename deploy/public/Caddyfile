# Caddy serves https://{$SENTINEL_DOMAIN}, obtains the certificate itself, and forwards to the app.
# The DNS A record for the domain must point at this machine, and ports 80 and 443 must be open.
{$SENTINEL_DOMAIN} {
	encode zstd gzip

	# Slightly above the app's own upload limit (MAX_UPLOAD_MB, default 20), so the app can give
	# a friendly error for oversized files.
	request_body {
		max_size 25MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy sentinel:8000
}
