# --- Inference (required) ---------------------------------------------------
# OpenAI-compatible endpoint. There is deliberately no default: in production
# this must be YOUR dedicated single-tenant vLLM endpoint (e.g. on Nebius AI Cloud).
# For development, any OpenAI-compatible endpoint works. Sentinel logs the host
# it talks to at startup. See deploy/README.md for serving Nemotron 3 Nano on vLLM.
#
#   vLLM (dedicated GPU):  http://<gpu-host>:8000/v1   model: whatever --served-model-name is
#   Nebius Token Factory:  https://api.tokenfactory.nebius.com/v1/   (dev only; multi-tenant)
LLM_BASE_URL=
# Model id exactly as the endpoint lists it (case-sensitive). Run `uv run sentinel preflight`
# to check it. Verified values:
#   Nebius Token Factory:  nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
#                          (NOT nvidia/nemotron-3-nano: that short form is not in its catalog)
#   Your own vLLM:         whatever you passed as --served-model-name (e.g. nemotron-3-nano)
LLM_MODEL=
# vLLM ignores the key unless started with --api-key; Token Factory needs a real one.
LLM_API_KEY=EMPTY
# Nemotron reasoning mode for judgement calls (chat_template_kwargs.enable_thinking).
LLM_REASONING=true
LLM_TEMPERATURE_REASONING=1.0
LLM_MAX_TOKENS=10000
LLM_TIMEOUT_SECONDS=120
# json_schema (OpenAI/vLLM response_format) | guided_json (vLLM extra_body) | prompt.
# If the server rejects response_format, Sentinel falls back to `prompt` automatically
# (output is always validated locally either way).
LLM_STRUCTURED_MODE=json_schema

# --- Verification (optional) ---------------------------------------------------
# Without a key, rules that need external confirmation resolve to `revisar`.
TAVILY_API_KEY=
MAX_SEARCHES_PER_REVIEW=5

# --- App ---------------------------------------------------------------------
VAULTS_DIR=vaults
AUDIT_LOG_PATH=audit/audit.jsonl
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=300000
MAX_WORKERS=4

# --- Public deployment (optional; see docs/hackathon.md) ------------------------
# The app has no login by default. When ACCESS_PASSWORD is set, every page and API call
# (except a minimal /healthz) requires HTTP Basic auth with these credentials. Use a long
# random password: `openssl rand -base64 18`. ACCESS_ and ADMIN_ below create the first two
# users; afterwards list them and reset their passwords on the console's Users page
# (/admin/user). Once reset there, the console's password is used and these are ignored.
ACCESS_USER=demo
ACCESS_PASSWORD=
# Super-admin login for the /status and /admin console (check keys and models, override
# settings at runtime). Disabled unless ADMIN_PASSWORD is set. 12+ characters; different from
# ACCESS_PASSWORD. The console can change where documents are sent, so treat it like root.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Cap on reviews per hour across all visitors, to protect your token and search credits.
# 0 means unlimited.
MAX_REVIEWS_PER_HOUR=0
# Hostname Caddy serves over HTTPS in deploy/public (docker-compose.yml).
SENTINEL_DOMAIN=
